{
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "msgpackr-extract",
      "esbuild"
    ]
  },
  "name": "salesagent-ai",
  "version": "1.0.0",
  "description": "SalesAgent AI - AI SDR / Outbound Sales Operating System",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev-worker": "pnpm --filter @salesagent/worker start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "seed": "pnpm --filter @salesagent/db seed",
    "seed-members": "pnpm tsx packages/db/seed-members.ts",
    "seed-prod": "pnpm tsx packages/db/seed-production.ts",
    "seed-verify-alice": "pnpm tsx packages/db/seed-verify-alice.ts",
    "clean-org": "pnpm tsx packages/db/clean-demo-org.ts",
    "seed-demo": "pnpm tsx packages/db/seed-demo.ts",
    "postinstall": "pnpm --filter @salesagent/db generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "turbo": "^2.9.12"
  }
}
