  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./parser": "./src/parser.ts",
    "./chunker": "./src/chunker.ts",
    "./embeddings": "./src/embeddings.ts",
    "./indexer": "./src/indexer.ts",
    "./storage": "./src/storage.ts",
    "./retriever": "./src/retriever.ts",
