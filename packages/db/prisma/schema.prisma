// packages/db/prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")    // Pooled connection for serverless (IPv4)
  directUrl = env("DIRECT_URL")      // Direct connection for migrations
  schemas   = ["sales_agent"]
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum MembershipRole {
  owner
  admin
  operator
  viewer

  @@schema("sales_agent")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String?
  passwordHash     String
  emailVerified    Boolean      @default(false)
  loginToken       String?
  loginTokenExpires DateTime?
  memberships      Membership[]
  leads            Lead[]       // Customer Portal — leads linked to this user account (Phase 19)
  createdAt        DateTime     @default(now())
  @@schema("sales_agent")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  memberships   Membership[]
  apiKeys       ApiKey[]
  featureFlags  FeatureFlag[]
  leads         Lead[]
  leadActivities LeadActivity[]
  agents        Agent[]
  conversations Conversation[]
  campaigns     Campaign[]
  scripts       Script[]
  auditLogs     AuditLog[]
  aiCallMetrics AICallMetric[]
  documents     Document[]
  documentChunks DocumentChunk[]
  createdAt     DateTime       @default(now())
  @@schema("sales_agent")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  prefix         String       // first 10 chars of key for display (e.g. "of_a1b2c3...")
  hashedKey      String       // SHA-256 of the full key — never stored in plaintext
  lastUsedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, hashedKey])
  @@index([organizationId])
  @@index([organizationId, prefix])
  @@schema("sales_agent")
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(admin)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  createdAt      DateTime       @default(now())
  @@unique([organizationId, userId])
  @@schema("sales_agent")
}

// ── AI SDR Agent ───────────────────────────────────────────────────

model Agent {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  personality    String?        // tone, voice, style (e.g. "Friendly, consultative, SPIN methodology")
  goals          Json?          // [{ type: "qualify_lead"|"book_meeting"|"handle_objection"|"nurture"|"follow_up", priority: 1, successCriteria: "..." }]
  knowledgeBase  Json?          // { productDescription, pricing, faq: [{q,a}], competitors: [{name, strengths, weaknesses}], caseStudies }
  isActive       Boolean        @default(true)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  conversations  Conversation[]
  campaigns      Campaign[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@schema("sales_agent")
}

// ── CRM Lead ───────────────────────────────────────────────────────

model Lead {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  email          String?
  company        String?
  phone          String?
  stage          String?        // new | contacted | qualified | proposal | negotiation | closed_won | closed_lost
  score          Int?           // AI score 0-100
  source         String?        // website | referral | outbound | linkedin | other
  assignedTo     String?
  dealAmount     Float?         // deal size in USD — enables real pipeline value (Phase 19)
  userId         String?        // links to User for Customer Portal access (Phase 19)
  tags           Json?
  organization   Organization   @relation(fields: [organizationId], references: [id])
  user           User?          @relation(fields: [userId], references: [id])
  activities     LeadActivity[]
  conversations  Conversation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@schema("sales_agent")
}

model LeadActivity {
  id             String       @id @default(uuid())
  leadId         String
  organizationId String
  userId         String?
  userName       String?
  type           String       // note | stage_change | email_sent | email_received | meeting_booked | assignment | created | updated
  content        String?
  metadata       Json?        // { fromStage, toStage, emailId, meetingDate } etc.
  createdAt      DateTime     @default(now())

  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@schema("sales_agent")
}

// ── Conversation & Messages ────────────────────────────────────────

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  leadId         String
  agentId        String?
  channel        String       @default("email") // email | chat | sms
  subject        String?
  status         String       @default("active") // active | awaiting_approval | approved | closed | archived
  lead           Lead         @relation(fields: [leadId], references: [id])
  agent          Agent?       @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@schema("sales_agent")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  direction      String       // inbound | outbound
  content        String
  channel        String       @default("email")
  aiMetadata     Json?        // { sentiment, intent, confidence, suggested_action } — AI analysis
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
  @@schema("sales_agent")
}

// ── Script Playbooks ───────────────────────────────────────────────

model Script {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  category       String?      // cold_outreach | follow_up | re_engagement | demo_request | objection_handling
  steps          Json         // [{ order, type: "email"|"ai_email"|"delay"|"condition", template, delay, condition }]
  organization   Organization @relation(fields: [organizationId], references: [id])
  campaigns      Campaign[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@schema("sales_agent")
}

// ── Outbound Campaign ──────────────────────────────────────────────

model Campaign {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  scriptId       String?
  agentId        String?
  status         String        @default("draft") // draft | active | paused | completed
  targetAudience Json?         // { stage, scoreMin, scoreMax, tags, source }
  schedule       Json?         // { timezone, workingHours, maxPerDay }
  stats          Json?         // { sent, delivered, opened, clicked, replied, booked, unsubscribed }
  script         Script?       @relation(fields: [scriptId], references: [id])
  agent          Agent?        @relation(fields: [agentId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  runs           CampaignRun[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@schema("sales_agent")
}

model CampaignRun {
  id             String       @id @default(uuid())
  campaignId     String
  status         String       @default("queued") // queued | running | completed | failed
  recipientCount Int?
  stats          Json?        // per-lead delivery tracking
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@schema("sales_agent")
}

// ── Knowledge Base (RAG) ──────────────────────────────────────────

model Document {
  id             String          @id @default(uuid())
  organizationId String
  name           String          // original file name
  type           String          // pdf | txt | md | faq
  status         String          @default("processing") // processing | ready | failed
  chunkCount     Int             @default(0)
  metadata       Json?           // { fileSize, uploadedAt, source }
  organization   Organization    @relation(fields: [organizationId], references: [id])
  chunks         DocumentChunk[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@schema("sales_agent")
}

model DocumentChunk {
  id             String       @id @default(uuid())
  documentId     String
  organizationId String
  content        String
  chunkIndex     Int
  metadata       Json?        // { title, fileName, section }
  searchVector   Unsupported("tsvector")?   @map("search_vector")  // Full-text search vector, managed by setup-vector.mjs
  embedding      Unsupported("vector")?    // pgvector embedding, managed by setup-vector.mjs
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([documentId, chunkIndex])
  @@index([organizationId])
  @@schema("sales_agent")
}

// ── Audit Log ──────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  userName       String?
  action         String       // e.g. "agent.created", "campaign.started", "lead.qualified", "conversation.closed"
  targetType     String       // e.g. "Agent", "Lead", "Campaign", "Script", "Conversation"
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@schema("sales_agent")
}

// ── AI Call Metrics ─────────────────────────────────────────────────

model AICallMetric {
  id               String   @id @default(uuid())
  organizationId   String
  jobType          String   // compose_response | score_lead | summarize_conversation | generate_script | campaign_ai | kb_ask
  model            String   @default("deepseek-chat")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  llmLatencyMs     Int
  totalLatencyMs   Int
  success          Boolean  @default(true)
  fallbackUsed     Boolean  @default(false)
  retryCount       Int      @default(0)
  errorType        String?
  requestId        String?
  conversationId   String?
  leadId           String?
  promptVersion    String?
  organization     Organization @relation(fields: [organizationId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, jobType])
  @@schema("sales_agent")
}

// ── Feature Flags ──────────────────────────────────────────────────

model FeatureFlag {
  id               String       @id @default(uuid())
  organizationId   String?
  key              String       // e.g. "ai_compose_response"
  enabled          Boolean      @default(true)
  rolloutPercent   Int          @default(100) // 0-100 for gradual rollouts
  rules            Json?        // { roles: ["admin"], userIds: [...] } — targeting rules
  description      String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([key])
  @@schema("sales_agent")
}
